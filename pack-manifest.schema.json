{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noah-ctx.dev/schema/pack-manifest/v1.json",
  "title": "Noah standards pack manifest",
  "description": "Editor autocompletion only. `noah pack validate` is the authority: it checks cross-references, section headings, path portability and template parsing, none of which JSON Schema can express.",
  "type": "object",
  "required": ["schemaVersion", "pack", "languages", "architectures", "aiAdapters"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "homepage": { "type": "string" }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "features": {
          "type": "array",
          "items": {
            "enum": ["arch-extends", "skill-capture", "adapter-limits", "pattern-rules", "template-blocks", "filter-inflect", "import-region"]
          }
        }
      }
    },
    "ignore": { "type": "array", "items": { "type": "string" } },
    "reporting": {
      "type": "object",
      "required": ["violationTemplate"],
      "additionalProperties": false,
      "properties": {
        "violationTemplate": { "type": "string" },
        "separator": { "type": "string" },
        "summaryTemplate": { "type": "string" },
        "exitCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125,
          "not": { "const": 2 },
          "description": "2 is reserved for contract errors and may not be reused."
        }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": { "type": "array", "items": { "type": "string" } },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "maxEntries": { "type": "integer", "minimum": 1 }
      }
    },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "languages": { "type": "array", "items": { "$ref": "#/$defs/language" } },
    "architectures": { "type": "array", "items": { "$ref": "#/$defs/architecture" } },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "features": {
      "type": "object",
      "required": ["docPath", "template", "requiredSections", "ruleTemplate"],
      "additionalProperties": false,
      "properties": {
        "docPath": { "type": "string" },
        "template": { "type": "string" },
        "requiredSections": { "type": "array", "items": { "type": "string" } },
        "ruleTemplate": { "type": "string" }
      }
    },
    "aiAdapters": { "type": "array", "items": { "$ref": "#/$defs/adapter" } }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "section": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },

    "transform": {
      "type": "array",
      "description": "Filters applied after validation. Filters are NOT allowed in template paths; declare the derivation here instead.",
      "items": {
        "oneOf": [
          { "enum": ["pascal", "camel", "kebab", "snake", "screaming", "dot", "title", "upper", "lower", "trim", "path", "dotPath", "plural", "singular"] },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "enum": ["pascal", "camel", "kebab", "snake", "screaming", "dot", "title", "upper", "lower", "trim", "path", "dotPath", "plural", "singular", "ensureSuffix", "stripSuffix", "ensurePrefix", "stripPrefix", "join", "regex"] },
              { "type": "string" }
            ]
          }
        ]
      }
    },

    "variable": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "displayName": { "type": "string" },
        "prompt": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform" },
        "validate": {
          "type": "object",
          "required": ["regex"],
          "additionalProperties": false,
          "properties": { "regex": { "type": "string", "format": "regex" }, "message": { "type": "string" } },
          "description": "Checked against the RAW value, before transform[]."
        },
        "sources": {
          "type": "array",
          "description": "Tried in order; the first non-empty value wins.",
          "items": {
            "type": "object",
            "required": ["from"],
            "additionalProperties": false,
            "properties": {
              "from": { "enum": ["flag", "config", "detect", "derive", "literal", "prompt"] },
              "name": { "type": "string" },
              "key": { "type": "string" },
              "file": { "type": "string" },
              "regex": { "type": "string", "format": "regex" },
              "group": { "type": "integer", "minimum": 0 },
              "template": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },

    "language": {
      "type": "object",
      "required": ["id", "extensions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "extensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\.[A-Za-z0-9.]+|[A-Za-z][A-Za-z0-9._-]*)$" }
        },
        "manifestFiles": { "type": "array", "items": { "type": "string" } },
        "ignore": { "type": "array", "items": { "type": "string" } },
        "install": { "type": "string" },
        "comment": {
          "type": "object",
          "required": ["strings"],
          "additionalProperties": false,
          "properties": {
            "line": { "type": "string" },
            "blockStart": { "type": "string" },
            "blockEnd": { "type": "string" },
            "strings": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "REQUIRED when comment is present. Without it every docstring and template literal containing 'import' is a false positive."
            }
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "regex"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "regex": { "type": "string", "format": "regex" },
              "flags": { "type": "string", "pattern": "^[gimsuy]*$" },
              "group": { "type": "integer", "minimum": 0 },
              "within": {
                "type": "object",
                "required": ["open", "close"],
                "additionalProperties": false,
                "properties": { "open": { "type": "string" }, "close": { "type": "string" } },
                "description": "Requires the import-region feature."
              }
            }
          }
        }
      }
    },

    "layer": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "section": { "$ref": "#/$defs/section" },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "$op": { "enum": ["remove", "replace"] }
      }
    },

    "rule": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "type": "string" },
        "section": { "$ref": "#/$defs/section" },
        "severity": { "enum": ["error", "warn", "off"] },
        "forbid": {},
        "allowOnly": {},
        "message": { "type": "string" },
        "$op": { "enum": ["remove", "replace"] }
      }
    },

    "architecture": {
      "type": "object",
      "required": ["id", "language", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "extends": { "type": "string", "description": "Requires the arch-extends feature." },
        "language": { "type": "string" },
        "framework": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } }
      }
    },

    "pattern": {
      "type": "object",
      "required": ["id", "section", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "section": { "type": "string", "pattern": "^5(\\.\\d+)*$", "description": "A fixed 5.<n> slot, globally unique across the pack." },
        "path": { "type": "string" },
        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "languages": { "type": "array", "items": { "type": "string" } },
            "architectures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "deps": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      }
    },

    "detector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dep": { "type": "string" },
        "ecosystem": { "enum": ["npm", "maven", "go", "pypi"] },
        "file": { "type": "string" },
        "match": { "type": "string", "format": "regex" },
        "capture": {
          "type": "object",
          "additionalProperties": { "type": ["integer", "string"] },
          "description": "A regex group index for a file detector; the selector \"version\" for a dep detector. Capturing from a .env file is rejected."
        },
        "any": { "type": "array", "items": { "$ref": "#/$defs/detector" } }
      }
    },

    "skill": {
      "type": "object",
      "required": ["id", "category", "path", "detect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "detect": {
          "type": "array",
          "items": { "$ref": "#/$defs/detector" },
          "description": "ALL entries are evaluated and their captures merged; short-circuit applies only inside `any`."
        }
      }
    },

    "adapter": {
      "type": "object",
      "required": ["id", "mode", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "mode": { "enum": ["file", "merge"] },
        "target": { "type": "string", "description": "May only use {{name}}." },
        "header": { "type": "string" },
        "preamble": { "type": "string" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "maxBytes": { "type": "integer", "minimum": 1 }, "onExceed": { "enum": ["warn", "error"] } }
        },
        "tierMap": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
